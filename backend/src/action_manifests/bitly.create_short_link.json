{
  "action_id": "bitly.create_short_link",
  "executor": "http",
  "ui": {
    "label": "Bitly",
    "description": "Shorten a URL with Bitly.",
    "category": "URL",
    "icon": "bitly"
  },
  "inputs": [
    {
      "name": "connection",
      "label": "Bitly account",
      "type": "oauth_connection",
      "provider": "bitly",
      "connection_scopes": ["personal", "workspace"],
      "required": true
    },
    {
      "name": "long_url",
      "label": "Long URL",
      "type": "string",
      "required": true
    }
  ],
  "http": {
    "method": "POST",
    "url": "https://api-ssl.bitly.com/v4/shorten",
    "headers": [
      {
        "key": "Authorization",
        "value": "Bearer {{connection.access_token}}"
      },
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],
    "queryParams": [],
    "bodyType": "json",
    "body": "{\"long_url\": \"{{params.long_url}}\"}",
    "formBody": []
  },
  "egress": {
    "allow": ["api-ssl.bitly.com"]
  }
}
