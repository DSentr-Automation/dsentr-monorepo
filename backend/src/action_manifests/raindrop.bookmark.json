{
  "action_id": "raindrop.bookmark",
  "executor": "http",

  "ui": {
    "label": "Raindrop",
    "description": "Create, update, or delete a bookmark in Raindrop.io.",
    "category": "Bookmarks",
    "icon": "raindrop"
  },

  "inputs": [
    {
      "name": "connection",
      "label": "Raindrop account",
      "type": "oauth_connection",
      "provider": "raindrop",
      "connection_scopes": ["personal", "workspace"],
      "required": true
    },

    {
      "name": "operation",
      "label": "Operation",
      "type": "enum",
      "options": ["create", "update", "delete"],
      "required": true
    },

    {
      "name": "bookmark_id",
      "label": "Bookmark ID",
      "type": "string",
      "required": false,
      "visible_when": {
        "operation": ["update", "delete"]
      }
    },

    {
      "name": "url",
      "label": "URL",
      "type": "string",
      "required": false,
      "visible_when": {
        "operation": ["create", "update"]
      }
    },

    {
      "name": "title",
      "label": "Title",
      "type": "string",
      "required": false,
      "visible_when": {
        "operation": ["create", "update"]
      }
    },

    {
      "name": "tags",
      "label": "Tags (comma separated)",
      "type": "string",
      "required": false,
      "visible_when": {
        "operation": ["create", "update"]
      }
    },

    {
      "name": "excerpt",
      "label": "Note",
      "type": "string",
      "required": false,
      "visible_when": {
        "operation": ["create", "update"]
      }
    }
  ],

  "http": {
    "method": "{{params.operation == 'delete' ? 'DELETE' : (params.operation == 'update' ? 'PUT' : 'POST')}}",

    "url": "{{params.operation == 'create'
      ? 'https://api.raindrop.io/rest/v1/raindrop'
      : 'https://api.raindrop.io/rest/v1/raindrop/' + params.bookmark_id}}",

    "headers": [
      {
        "key": "Authorization",
        "value": "Bearer {{connection.access_token}}"
      },
      {
        "key": "Content-Type",
        "value": "application/json"
      }
    ],

    "queryParams": [],

    "bodyType": "json",

    "body": "{{params.operation == 'delete'
      ? null
      : {
          \"link\": \"{{params.url}}\",
          \"title\": \"{{params.title}}\",
          \"tags\": \"{{params.tags}}\",
          \"excerpt\": \"{{params.excerpt}}\"
        }}}",

    "formBody": []
  },

  "egress": {
    "allow": ["api.raindrop.io"]
  }
}
