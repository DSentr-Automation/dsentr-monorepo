{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "executor",
    "ui",
    "inputs",
    "http"
  ],
  "properties": {
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "executor": {
      "type": "string",
      "enum": ["http"]
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "description",
        "category",
        "icon"
      ],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "icon": {"type": "string", "minLength": 1}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label", "type", "required"],
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "required": { "type": "boolean" },

          "provider": {
            "type": "string",
            "minLength": 1
          },
          "connection_scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["personal", "workspace"]
            },
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "oauth_connection" } }
            },
            "then": {
              "required": ["provider"]
            }
          }
        ]
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url",
        "headers",
        "queryParams",
        "bodyType",
        "body",
        "formBody"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]
        },
        "url": {"type": "string", "minLength": 1},
        "headers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "value": {"type": "string"}
            }
          }
        },
        "queryParams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "value": {"type": "string"}
            }
          }
        },
        "bodyType": {
          "type": "string",
          "enum": ["raw", "json", "form"]
        },
        "body": {"type": "string"},
        "formBody": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "value": {"type": "string"}
            }
          }
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}